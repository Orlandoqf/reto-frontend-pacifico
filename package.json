{
  "name": "reto-pacifico-frontend",
  "version": "1.0.0",
  "description": "Pruebas automatizadas de Sauce Demo con Playwright y Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:happypath": "cucumber-js --tags @happypath",
    "test:unhappypath": "cucumber-js --tags @unhappypath",
    "test:pw": "bddgen && playwright test",
    "test:pw:headed": "bddgen && playwright test --headed",
    "test:pw:happypath": "bddgen && playwright test --grep @happypath",
    "test:pw:unhappypath": "bddgen && playwright test --grep @unhappypath",
    "report:pw": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "playwright-bdd": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
